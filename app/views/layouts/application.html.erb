<!DOCTYPE html>
<html lang="en">
  <head>
    <title><%= content_for(:title) || "crest" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="description" content="<%= content_for(:description) || "Every match the USMNT has played. The United States Men&rsquo;s National Soccer Team, 1885 to now." %>">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Serif:ital,wght@0,600;0,700;1,600&family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600&display=swap">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
    <%= yield :head %>
  </head>

  <body data-controller="model-context">
    <%# This must live in the body. Turbo Drive replaces the body on every
        visit but leaves the head alone, so a manifest in the head would be
        frozen at the first page loaded and page scoping would never apply. %>
    <script type="application/json" id="model-context-manifest"><%== ModelContext::Manifest.new(page: controller_name).to_json %></script>

    <div class="accent" aria-hidden="true"></div>

    <div class="wrap">
      <header class="masthead">
        <%= link_to root_path, class: "wordmark" do %>
          <%= render "shared/crest", width: 27, fill: "#14213d", letter: "#f4f1e8" %>
          <span>crest</span>
        <% end %>

        <nav class="nav cap">
          <%= link_to "Cycles", cycles_path, class: ("on" if controller_name == "cycles") %>
          <%= link_to "Players", players_path, class: ("on" if controller_name == "players") %>
          <%= link_to "Sources", sources_path, class: ("on" if controller_name == "sources") %>
        </nav>

        <%= link_to tools_path, class: "badge", title: "This site offers tools to AI agents. Learn how to use them.",
                    data: { model_context_target: "indicator" } do %>
          <span class="dot"></span>
          <span class="mark">WebMCP</span>
          <span class="state" data-model-context-target="label">how to turn it on</span>
        <% end %>
      </header>
      <hr class="rule">

      <main><%= yield %></main>

      <footer>
        <hr class="hair">
        <p class="credit">
          Match data: <a href="https://github.com/martj42/international_results">martj42/international_results</a>, CC0-1.0.
          Cycles, records and rankings computed by crest. Caps counted from launch.
          <%= link_to "Sources", sources_path %> &middot;
          <a href="https://github.com/leemcalilly/crest">Source code</a>, MIT.
        </p>
      </footer>
    </div>
  </body>
</html>
