<%# A small flag in crest's own palette — oxblood and navy rather than
    clip-art primaries, so it belongs to the page. Seven stripes and a canton;
    thirteen stripes turn to mud below about 40px. %>
<svg width="<%= width %>" height="<%= (width * 20.0 / 38).round %>" viewBox="0 0 38 20"
     xmlns="http://www.w3.org/2000/svg" role="img"
     aria-label="United States men's national soccer team">
  <rect width="38" height="20" fill="#f9f7f2"></rect>

  <g fill="#8c1d18">
    <rect y="0"      width="38" height="2.86"></rect>
    <rect y="5.71"   width="38" height="2.86"></rect>
    <rect y="11.43"  width="38" height="2.86"></rect>
    <rect y="17.14"  width="38" height="2.86"></rect>
  </g>

  <rect width="16.2" height="11.43" fill="#14213d"></rect>
  <g fill="#f9f7f2">
    <circle cx="3.6"  cy="2.7" r="0.85"></circle>
    <circle cx="8.1"  cy="2.7" r="0.85"></circle>
    <circle cx="12.6" cy="2.7" r="0.85"></circle>
    <circle cx="5.85" cy="5.7" r="0.85"></circle>
    <circle cx="10.35" cy="5.7" r="0.85"></circle>
    <circle cx="3.6"  cy="8.7" r="0.85"></circle>
    <circle cx="8.1"  cy="8.7" r="0.85"></circle>
    <circle cx="12.6" cy="8.7" r="0.85"></circle>
  </g>

  <rect width="38" height="20" fill="none" stroke="#1a1815" stroke-opacity="0.18" stroke-width="1"></rect>
</svg>
