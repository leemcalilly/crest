<%# The 2026 kit. The hem at the foot of the page is the real thing — thick
    bands with air between them. The collar at the top is a single light
    ripple, an accent rather than a repeat. Decorative only. %>
<% hem = edge == "bottom" %>
<% amplitude = hem ? 15 : 5 %>
<% thickness = hem ? 26 : 6 %>
<% height = hem ? 168 : 30 %>
<% stripes = hem ? [ [ 8, 0.92, "s1" ], [ 62, 0.72, "s2" ], [ 116, 0.5, "s3" ] ] : [ [ 10, 0.4, "s2" ] ] %>

<div class="waves <%= edge %>" aria-hidden="true">
  <svg viewBox="0 0 2400 <%= height %>" preserveAspectRatio="none" xmlns="http://www.w3.org/2000/svg"
       style="height: <%= height %>px;">
    <defs>
      <path id="ripple-<%= edge %>" d="<%= ripple_path(amplitude:, thickness:) %>"></path>
    </defs>
    <g fill="#8c1d18">
      <% stripes.each do |y, opacity, speed| %>
        <use href="#ripple-<%= edge %>" y="<%= y %>" class="<%= speed %>" opacity="<%= opacity %>"></use>
      <% end %>
    </g>
  </svg>
</div>
