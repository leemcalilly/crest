    agate tables stay the loudest thing on the page. %>
<div class="waves" aria-hidden="true">
  <svg viewBox="0 0 1600 900" preserveAspectRatio="xMidYMid slice" xmlns="http://www.w3.org/2000/svg">
    <defs>
      <path id="band" d="M-400,0 C-100,-42 200,42 500,0 C800,-42 1100,42 1400,0 C1700,-42 2000,42 2300,0 L2300,66 C2000,108 1700,24 1400,66 C1100,108 800,24 500,66 C200,108 -100,24 -400,66 Z"></path>
    </defs>
    <g fill="#8c1d18">
      <use href="#band" y="30" class="w1"></use>
      <use href="#band" y="170" class="w2"></use>
      <use href="#band" y="310" class="w3"></use>
      <use href="#band" y="450" class="w1"></use>
      <use href="#band" y="590" class="w2"></use>
      <use href="#band" y="730" class="w3"></use>
      <use href="#band" y="870" class="w1"></use>
    </g>
  </svg>
</div>
