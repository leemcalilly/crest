<%# The mark: soft-shoulder shield, navy, one oxblood rule, cream serif c. %>
<svg width="<%= width %>" height="<%= (width * 92.0 / 80).round %>" viewBox="0 0 80 92"
     xmlns="http://www.w3.org/2000/svg" role="img" aria-label="crest">
  <path d="M13 4 H67 A8 8 0 0 1 75 12 V48 C75 70 57 82 40 88 C23 82 5 70 5 48 V12 A8 8 0 0 1 13 4 Z"
        fill="<%= fill %>"></path>
  <path d="M13 30 H67" stroke="#8c1d18" stroke-width="4"></path>
  <% if width >= 20 %>
    <text x="40" y="68" text-anchor="middle" fill="<%= letter %>"
          font-family="IBM Plex Serif, Georgia, serif" font-weight="700" font-size="46">c</text>
  <% end %>
</svg>
