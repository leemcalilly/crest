<% content_for :title, "#{@player.name} — crest" %>

<section style="padding: 30px 0 0;">
  <div class="card" style="max-width: 640px;">
    <div class="band">
      <div style="display: flex; align-items: center; gap: 12px;">
        <%= render "shared/crest", width: 22, fill: "#f4f1e8", letter: "#14213d" %>
        <span class="cap">Men</span>
      </div>
      <div class="cap">No. <%= @player.rank %> all-time</div>
    </div>

    <% goals_by_cycle = @player.goals_by_cycle %>
    <div class="body" style="padding-bottom: 0;">
      <h1 class="serif" style="font-weight: 700; font-size: 46px; letter-spacing: -0.035em; line-height: 1; margin: 0;">
        <%= @player.name %>
      </h1>
      <div class="num" style="font-size: 13px; color: var(--ink-faint); padding-top: 8px;">
        <%= @player.first_goal_on.year %> &ndash; <%= @player.last_goal_on.year %> &middot;
        <%= pluralize goals_by_cycle.size, "cycle" %>
      </div>

      <div style="display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 0; padding: 22px 0 0;">
        <div><div class="num" style="font-size: 42px; line-height: 1; color: var(--oxblood);"><%= @player.goal_count %></div><div class="cap" style="padding-top: 5px;">goals</div></div>
        <div><div class="num" style="font-size: 42px; line-height: 1; color: var(--bar-faint);">&mdash;</div><div class="cap" style="padding-top: 5px;">caps</div></div>
        <div><div class="num" style="font-size: 42px; line-height: 1;"><%= @player.penalties %></div><div class="cap" style="padding-top: 5px;">penalties</div></div>
        <div><div class="num" style="font-size: 42px; line-height: 1;"><%= @player.average_minute %>'</div><div class="cap" style="padding-top: 5px;">avg minute</div></div>
      </div>

      <div style="padding: 24px 0 0;">
        <hr class="hair">
        <div class="cap" style="padding: 14px 0 12px;">Goals by cycle</div>
        <% peak = goals_by_cycle.map(&:last).max.to_f %>
        <div style="display: flex; align-items: flex-end; gap: 10px; height: 92px;">
          <% goals_by_cycle.each do |cycle, n| %>
            <div style="flex-grow: 1; display: flex; flex-direction: column; justify-content: flex-end; align-items: center; gap: 6px;">
              <div class="num" style="font-size: 15px;"><%= n %></div>
              <div style="width: 100%; background: <%= n == peak ? "var(--navy)" : "var(--bar)" %>; height: <%= (n / peak * 70).round %>px;"></div>
            </div>
          <% end %>
        </div>
        <div style="display: flex; gap: 10px; padding-top: 7px;">
          <% goals_by_cycle.each do |cycle, _| %>
            <div class="cap" style="flex-grow: 1; text-align: center;">
              <%= link_to cycle.world_cup_year || "<1930", cycle_path(cycle) %>
            </div>
          <% end %>
        </div>
      </div>

      <% if @player.world_cup_goals.any? %>
        <div style="padding: 22px 0 0;">
          <hr class="hair">
          <div class="cap" style="padding: 14px 0 10px;">World Cup goals</div>
          <table style="font-size: 12px;">
            <tbody>
              <% @player.world_cup_goals.each do |goal| %>
                <tr>
                  <td class="faint" style="border-top-color: var(--rule-faint);"><%= goal.match.played_on.year %></td>
                  <td class="name" style="font-size: 15px; border-top-color: var(--rule-faint);"><%= goal.match.opponent %></td>
                  <td class="n" style="border-top-color: var(--rule-faint); <%= "color: var(--oxblood); font-weight: 600;" if goal.minute && goal.minute <= 1 %>"><%= goal.minute %>'</td>
                </tr>
              <% end %>
            </tbody>
          </table>
        </div>
      <% end %>

      <div style="padding: 22px 0 24px;">
        <hr class="hair">
        <div class="cap" style="padding: 14px 0 10px;">Scored most against</div>
        <div style="display: flex; flex-wrap: wrap; gap: 8px;">
          <% @player.top_opponents.each do |opponent, n| %>
            <span class="num" style="border: 1px solid var(--rule); padding: 6px 11px; font-size: 12px; font-weight: 400;">
              <%= opponent %> <strong><%= n %></strong>
            </span>
          <% end %>
        </div>
      </div>
    </div>

    <div class="foot">
      <strong>What this card does not know.</strong>
      Goals count only what the open record holds &mdash; major tournaments, and friendlies unevenly &mdash;
      so the true total is higher. Caps show a dash: appearance data does not exist in the source at all,
      and crest counts them from launch forward. No position, no club, no minutes played.
    </div>
  </div>
</section>
